{
  "name": "skimjob",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:scoped": "node scripts/scope.mjs --run",
    "precheck": "node scripts/precheck.mjs",
    "test:pg": "bash scripts/db.sh start && DATABASE_URL=$(bash scripts/db.sh url) vitest run apps/server",
    "typecheck": "pnpm -r --if-present typecheck",
    "sim": "pnpm --filter @skimjob/sim start",
    "sim:suite": "pnpm --filter @skimjob/sim suite",
    "dev": "pnpm --filter @skimjob/server dev",
    "web": "pnpm --filter @skimjob/web dev",
    "test:e2e": "pnpm --filter @skimjob/web test:e2e",
    "knip": "knip",
    "lint:theme": "node scripts/theme-lint.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "knip": "^6.44.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
